# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store

# ---------------------------------------------------------------------------
# Data (large; kept locally, not in git). data/ is read-only inputs;
# cluster-output/ is everything the pipeline generates (mirrors data/).
# ---------------------------------------------------------------------------
data/
cluster-output/

# Generated pipeline outputs (regenerated by the clustering pipeline).
# These patterns also apply if you un-ignore data/ above.
**/approach1/
**/approach2/
**/approach3/
**/validation/
**/figures/
**/gifs/
**/*.log

# query_app: the prebuilt db + cache + csv are checked in on purpose (they live
# alongside the app module at src/zn_cys_his/query_app/). Nothing to un-ignore
# here as long as data/ is the only ignored tree; listed for clarity.
!src/zn_cys_his/query_app/structures.db
!src/zn_cys_his/query_app/metadata_cache.json
!src/zn_cys_his/query_app/csv/
